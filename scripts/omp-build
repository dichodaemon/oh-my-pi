#!/usr/bin/env bash
# omp-build -- Build oh-my-pi from source (JS deps + Rust natives).
#
#   Full build:       omp-build
#   Skip natives:     omp-build --skip-natives
#
set -euo pipefail

OMP_REPO="${OMP_REPO:-/workspace/oh-my-pi}"

# ── defaults ────────────────────────────────────────────────────
skip_natives=false

# ── output ──────────────────────────────────────────────────────
cyn=$'\033[0;36m' grn=$'\033[0;32m' ylw=$'\033[0;33m'
red=$'\033[0;31m' rst=$'\033[0m'

step() { printf '%s>>>%s %s\n' "$cyn" "$rst" "$*"; }
ok()   { printf '%s>>>%s %s\n' "$grn" "$rst" "$*"; }
warn() { printf '%s !! %s%s\n' "$ylw" "$rst" "$*" >&2; }
err()  { printf '%s!!!%s %s\n' "$red" "$rst" "$*" >&2; }
die()  { err "$@"; exit 1; }

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Build oh-my-pi from source: install JS dependencies and compile
Rust native binaries.

Options:
  --skip-natives    Skip the Rust native binary rebuild
  -h, --help        Show this help

Environment:
  OMP_REPO    Path to oh-my-pi checkout (default: /workspace/oh-my-pi)
EOF
}

# ── arg parsing ─────────────────────────────────────────────────
while [ $# -gt 0 ]; do
    case "$1" in
        --skip-natives) skip_natives=true ;;
        -h|--help)      usage; exit 0 ;;
        *)              die "Unknown option: $1" ;;
    esac
    shift
done

# ── main ────────────────────────────────────────────────────────
cd "$OMP_REPO" || { err "Cannot cd to $OMP_REPO (set OMP_REPO to override)"; exit 3; }
[ -d .git ] || { err "Not a git repository: $OMP_REPO"; exit 3; }
command -v bun >/dev/null || die "bun not found in PATH"

step "Installing JS dependencies"
if ! bun install; then
    err "bun install failed."
    exit 2
fi

if [ "$skip_natives" = false ]; then
    command -v cargo >/dev/null || die "cargo not found in PATH (needed for native build)"
    step "Rebuilding native binaries (Rust — may take a few minutes)"
    if ! bun --cwd=packages/natives run build; then
        err "Native build failed."
        err "Skip natives: $(basename "$0") --skip-natives"
        exit 2
    fi
else
    warn "Skipping native rebuild (--skip-natives)"
fi

ok "Build complete."
